# Build context is the repository root (see docker-compose.yml), because the
# worker is built as part of the Maven reactor together with taskmesh-common.

FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

# Copy just the POMs first so dependency resolution is cached across builds
# as long as no dependency changes.
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY taskmesh-common/pom.xml taskmesh-common/pom.xml
COPY taskmesh-control-plane/pom.xml taskmesh-control-plane/pom.xml
COPY taskmesh-worker/pom.xml taskmesh-worker/pom.xml
# The reactor root lists taskmesh-loadgen, so its pom must be present for
# dependency resolution even though this image never builds that module.
COPY taskmesh-loadgen/pom.xml taskmesh-loadgen/pom.xml
RUN chmod +x mvnw && \
    ./mvnw -q -B -pl taskmesh-worker -am dependency:go-offline

COPY taskmesh-common/src taskmesh-common/src
COPY taskmesh-worker/src taskmesh-worker/src
RUN ./mvnw -q -B -pl taskmesh-worker -am package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --create-home taskmesh
USER taskmesh
COPY --from=build /workspace/taskmesh-worker/target/taskmesh-worker-*.jar app.jar

# networkaddress.cache.ttl: the JVM caches successful DNS lookups, and a
# container that restarts can come back on a different IP. Without a
# bounded TTL the client keeps reconnecting to the old address forever -
# observed with Redis, where recovery after an outage never happened
# because Lettuce retried an IP another container had since taken over.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -Dnetworkaddress.cache.ttl=10"

EXPOSE 8081

# The worker's own liveness only. It must not be reported unhealthy merely
# because the control plane is unreachable: it retries registration by
# itself, and restarting it would not fix the control plane.
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
    CMD curl -fsS http://localhost:8081/actuator/health/liveness || exit 1

# Exec form so the JVM is PID 1 and SIGTERM reaches it directly - graceful
# shutdown depends on that signal arriving.
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
