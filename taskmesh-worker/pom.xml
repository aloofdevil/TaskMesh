<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.taskmesh</groupId>
		<artifactId>taskmesh-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>taskmesh-worker</artifactId>
	<name>taskmesh-worker</name>
	<description>TaskMesh Worker - claims and executes jobs from the control plane (skeleton only, Day 1)</description>

	<!--
		Deliberately minimal: the worker talks to the control plane over REST
		only (see docs/architecture.md - pull model), so it has no direct
		PostgreSQL/Redis/Kafka dependency. spring-boot-starter-webmvc is
		included now because the claim/heartbeat HTTP client (Day 3) and the
		liveness/readiness probes (Day 6) both need it; no claim/heartbeat/
		execution logic is implemented yet.
	-->
	<dependencies>
		<dependency>
			<groupId>com.taskmesh</groupId>
			<artifactId>taskmesh-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!--
			The worker's only outbound channel. spring-boot-starter-webmvc is
			server-side only; in Spring Boot 4 the RestClient auto-configuration
			(and its RestClient.Builder bean) lives in this separate starter.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
